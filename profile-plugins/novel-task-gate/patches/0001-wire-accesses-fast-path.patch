+# ---------------------------------------------------------------------------
+# Accesses credential fast path (P0, 2026-08-13)
+# ---------------------------------------------------------------------------
+# "вот логин/пароль от X, положи в <repo>/accesses/x.md" is a ONE-WRITE request
+# the user spelled out verbatim, yet `write_file` is in HARD_DENY_TRIVIAL, so it
+# used to pay the full classify -> plan -> nonce-critic -> resolve ceremony —
+# five extra API requests, a delegated critic, and the plaintext credential kept
+# alive in context far longer than necessary.
+#
+# `accesses_fast_path` mints a lease from the USER'S OWN message and authorizes
+# EXACTLY ONE `write_file` to the ONE `<repo>/accesses/<name>.md` path that
+# message named. The post hook then mechanically chmods 0700/0600, guarantees the
+# exact `/accesses/` line in the repo's root .gitignore, verifies the path is
+# ignored AND untracked, and appends a deterministic NON-SECRET readback.
+# Everything else stays gated; every failure removes the file this path created.
+#
+# This is the ONLY text-derived authority in the plugin, and it is narrow by
+# construction: the lease grants no classification, no second tool, no second
+# path, no commit/push/send — just the write the user typed out. Real
+# write-guards (gate-prod-writes.sh / gate-self-edit.sh) still run.
+try:  # pragma: no cover - import shape depends on how the plugin is loaded
+    from . import accesses_fast_path as _AFP  # type: ignore
+except Exception:
+    try:
+        import accesses_fast_path as _AFP  # type: ignore
+    except Exception:
+        _AFP = None  # type: ignore
+        logging.getLogger(__name__).info(
+            "novel-task-gate: accesses_fast_path unavailable; fast path disabled"
+        )
+
+# (session_id, turn_id) -> AccessesLease. Bounded; dropped with the turn.
+_ACCESS_LEASES: "OrderedDict[Tuple[str, str], Any]" = OrderedDict()
+MAX_ACCESS_LEASES = 128
+
+
+def _mint_access_lease(session_id: str, turn_id: str, user_message: Any) -> None:
+    """Mint at most one accesses lease per turn from the user's own message."""
+    if _AFP is None or not turn_id or not isinstance(user_message, str):
+        return
+    lease = _AFP.mint_lease(user_message)
+    if lease is None:
+        return
+    key = (session_id or "", turn_id)
+    with _LOCK:
+        _ACCESS_LEASES[key] = lease
+        _ACCESS_LEASES.move_to_end(key)
+        while len(_ACCESS_LEASES) > MAX_ACCESS_LEASES:
+            _ACCESS_LEASES.popitem(last=False)
+    # Path only — never the message, never the credential.
+    logger.info("novel-task-gate: accesses fast-path armed for %s", lease.rel_path)
+
+
+def _get_access_lease(session_id: str, turn_id: str):
+    if _AFP is None or not turn_id:
+        return None
+    with _LOCK:
+        return _ACCESS_LEASES.get((session_id or "", turn_id))
+
+
+def _drop_access_leases(session_id: str, turn_id: str = "") -> None:
+    with _LOCK:
+        dead = [
+            k for k in _ACCESS_LEASES
+            if k[0] == (session_id or "") and (not turn_id or k[1] == turn_id)
+        ]
+        for k in dead:
+            _ACCESS_LEASES.pop(k, None)
+
+
+def _accesses_fast_path_allows(session_id: str, turn_id: str, tool_name: str, args) -> bool:
+    """True iff this call is the single write the user's own message authorized."""
+    if _AFP is None:
+        return False
+    try:
+        lease = _get_access_lease(session_id, turn_id)
+        if not _AFP.authorizes(lease, tool_name, args):
+            return False
+        # Remember whether WE created the file: fail-closed cleanup must never
+        # delete a drop that already existed before this turn.
+        if lease.preexisting is None:
+            lease.preexisting = os.path.exists(lease.target_path)
+        return True
+    except Exception as exc:
+        logger.warning("accesses fast-path pre error: %s", exc)
+        return False
+
+
+def _accesses_fast_path_finalize(
+    session_id: str, turn_id: str, tool_name: str, args, result, status,
+) -> None:
+    """Harden + verify the drop. Runs OUTSIDE _LOCK (filesystem + read-only git)."""
+    if _AFP is None or tool_name != _AFP.WRITE_TOOL:
+        return
+    try:
+        lease = _get_access_lease(session_id, turn_id)
+        # `preexisting is None` means this turn never admitted a fast-path write,
+        # so an unrelated write_file can never trigger the hardening.
+        if lease is None or lease.finalized or lease.preexisting is None:
+            return
+        if not _tool_succeeded(result, status):
+            return
+        _AFP.finalize(lease)
+    except Exception as exc:
+        logger.warning("accesses fast-path finalize error: %s", exc)
+
+
 EXEMPT_PLATFORMS = frozenset({"subagent", "cron"})
 
